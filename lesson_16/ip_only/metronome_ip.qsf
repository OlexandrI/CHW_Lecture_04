# metronome_ip.qsf
# Metronome resources without the processor
# OlexandrI.B

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA4F23C6
set_global_assignment -name TOP_LEVEL_ENTITY metronome
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name VERILOG_FILE ../ip/metronome.v
set_global_assignment -name SDC_FILE timing.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_instance_assignment -name VIRTUAL_PIN ON -to "reset"
set_instance_assignment -name VIRTUAL_PIN ON -to "address[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "read"
set_instance_assignment -name VIRTUAL_PIN ON -to "write"
set_instance_assignment -name VIRTUAL_PIN ON -to "byteenable[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "writedata[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "readdata[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "waitrequest"
set_instance_assignment -name VIRTUAL_PIN ON -to "tick"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
