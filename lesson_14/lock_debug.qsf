# lock_debug.qsf
# Signal Tap and VIO project for Cyclone V
# OlexandrI.B

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA4F23C6
set_global_assignment -name TOP_LEVEL_ENTITY debug_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SYSTEMVERILOG_FILE rtl/digit_debounce.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/lock_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ila_0.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug_top.sv
set_global_assignment -name QIP_FILE debug_ip/synthesis/debug_ip.qip
set_global_assignment -name SDC_FILE timing.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name ENABLE_SIGNALTAP ON
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to "digit_in[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to unlocked_led

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top