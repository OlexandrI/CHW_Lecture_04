# lock_controller.qsf
# Separate Cyclone V project
# OlexandrI.B

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA4F23C6
set_global_assignment -name TOP_LEVEL_ENTITY lock_controller
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SDC_FILE timing.sdc
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name SYSTEMVERILOG_FILE digit_debounce.sv
set_global_assignment -name SYSTEMVERILOG_FILE lock_controller.sv

# Boardless timing project
set_instance_assignment -name VIRTUAL_PIN ON -to "rst"
set_instance_assignment -name VIRTUAL_PIN ON -to "digit_in[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "unlocked_led"

set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (SystemVerilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_lock -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_lock -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_lock -section_id tb_lock
set_global_assignment -name EDA_TEST_BENCH_FILE tb_lock.sv -section_id tb_lock

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
