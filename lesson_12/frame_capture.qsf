# frame_capture.qsf
# Frame capture project for Cyclone V
# OlexandrI.B

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEFA4F23C6
set_global_assignment -name TOP_LEVEL_ENTITY frame_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SYSTEMVERILOG_FILE rtl/frame_top.sv
set_global_assignment -name QIP_FILE frame_system/synthesis/frame_system.qip
set_global_assignment -name SDC_FILE timing.sdc
set_global_assignment -name IP_SEARCH_PATHS "rtl/**/*"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_instance_assignment -name VIRTUAL_PIN ON -to reset_n
set_instance_assignment -name VIRTUAL_PIN ON -to button
set_instance_assignment -name VIRTUAL_PIN ON -to "pixel_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to pixel_valid
set_instance_assignment -name VIRTUAL_PIN ON -to pixel_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "debug_status[*]"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"